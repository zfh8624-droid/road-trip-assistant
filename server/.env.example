# ====== 行野公路旅行助手 · 后端配置示例 ======
# 复制此文件为 .env 并填入真实值（.env 已加入 .gitignore，不会被提交）

# PostgreSQL 连接串
DATABASE_URL="postgresql://用户名:密码@主机:端口/数据库名?schema=public"

# 服务端口（可选）
PORT=3000

# ====== 地理服务 ======
# 高德开放平台 → 控制台 → 创建「Web服务」类型的应用 Key
# https://console.amap.com/dev/key/app
AMAP_KEY=""
# 安全密钥（非必须，如在高德控制台启用了则填写）
AMAP_SECRET=""

# ====== 鉴权 ======
# 上线前务必修改为随机长字符串（至少 32 字节），
# 例如：openssl rand -hex 32
TOKEN_SECRET="xingye-dev-secret-change-me-in-prod"

# ====== 微信小程序登录（可选）======
# 不需要小程序登录可留空（默认会走匿名兜底）
WECHAT_APPID=""
WECHAT_SECRET=""
