09);font-size:16rpx;color:#aac2b7}.day text{font-size:22rpx;color:#fff;font-weight:700}.day.active{background:#ff8b4d;color:#fff}.timeline{border-top:1rpx solid rgba(255,255,255,.12)}.event{display:grid;grid-template-columns:78rpx 1fr;gap:10rpx;padding:18rpx 0;border-bottom:1rpx dashed rgba(255,255,255,.12)}.event text{display:block;font-size:22rpx}.event view text+text{font-size:18rpx;color:#a9c0b7;margin-top:5rpx}.time{font-size:18rpx!important;color:#a9c0b7}.supply{display:flex;align-items:center;gap:17rpx;padding:18rpx;background:#fff;border:1rpx solid #e3ebe7;border-radius:17rpx;margin-bottom:12rpx}.supply-icon{width:56rpx;height:56rpx;border-radius:14rpx;display:grid;place-items:center;font-weight:700}.fuel{background:#fff0e9;color:#ff8b4d}.charge{background:#e4f6ed;color:#30a979}.supply text{display:block;font-size:22rpx;font-weight:700}.supply text+text{font-size:18rpx;color:#72827f;margin-top:5rpx;font-weight:400}.tabbar{position:fixed;left:0;right:0;bottom:0;height:118rpx;background:rgba(255,255,255,.96);display:flex;justify-content:space-around;align-items:center;border-top:1rpx solid #e3ebe7;z-index:8}.tabbar view{display:flex;flex-direction:column;align-items:center;color:#9aaba4;font-size:28rpx}.tabbar text{font-size:18rpx;margin-top:4rpx}.tabbar .active{color:#30a979}.mask{position:fixed;inset:0;background:rgba(9,28,26,.5);z-index:20;display:flex;align-items:flex-end}.modal{width:100%;max-height:82vh;overflow:auto;background:#fff;border-radius:30rpx 30rpx 0 0;padding:30rpx 34rpx calc(35rpx + env(safe-area-inset-bottom))}.modal-head{display:flex;justify-content:space-between;font-size:32rpx;font-weight:700;margin-bottom:25rpx}.field-label{display:block;font-size:21rpx;font-weight:700;margin:20rpx 0 9rpx}.picker{padding:20rpx;border:1rpx solid #e1e9e5;border-radius:14rpx;background:#fafcfb;font-size:23rpx}.check{display:inline-flex;align-items:center;margin:0 18rpx 12rpx 0;font-size:21rpx}.save{margin-top:20rpx;background:#102d2a!important;color:#fff!important;font-size:24rpx!important}.profile{display:flex;align-items:center;gap:18rpx}.avatar{width:70rpx;height:70rpx;border-radius:50%;background:#dff6eb;display:grid;place-items:center;color:#176746;font-weight:700}.profile text{display:block;font-size:25rpx;font-weight:700}.profile text+text{font-size:19rpx;color:#72827f;margin-top:5rpx;font-weight:400}.profile-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin:25rpx 0}.profile-stats view{background:#f4f8f6;border-radius:14rpx;padding:18rpx;text-align:center}.profile-stats text{display:block;font-size:29rpx;font-weight:700}.profile-stats text+text{font-size:18rpx;color:#72827f;margin-top:5rpx}
